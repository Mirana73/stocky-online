# Copiez ce fichier en ".env" pour tester en local (non nécessaire pour le déploiement en ligne,
# où ces valeurs se configurent dans l'interface de votre hébergeur).

# Chaîne de connexion PostgreSQL fournie par Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Mot de passe pour protéger l'accès à votre application (choisissez-en un robuste)
APP_PASSWORD=changez-moi

# Port local (Render/Railway le définissent automatiquement, inutile de le changer)
PORT=3000
